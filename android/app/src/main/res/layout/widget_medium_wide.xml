<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_m3"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left Hero Pill -->
    <LinearLayout
        android:id="@+id/widget_med_hero"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_hero_pill_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shortcut_logo" />

        <TextView
            android:id="@+id/widget_med_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="@color/m3_widget_on_primary_container"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="cultius"
            android:textColor="@color/m3_widget_on_primary_container"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right: Top 3 Categories -->
    <LinearLayout
        android:id="@+id/widget_med_categories"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Category Row 1 -->
        <LinearLayout
            android:id="@+id/cat_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cat_icon_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="icon"
                android:src="@drawable/ic_cat_eco" />

            <TextView
                android:id="@+id/cat_label_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Fulla"
                android:textColor="@color/m3_widget_text_primary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/cat_progress_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="70dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="60"
                android:progressDrawable="@drawable/m3_progress_bar" />

            <TextView
                android:id="@+id/cat_count_1"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:gravity="end"
                android:text="12"
                android:textColor="@color/m3_widget_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Category Row 2 -->
        <LinearLayout
            android:id="@+id/cat_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cat_icon_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="icon"
                android:src="@drawable/ic_cat_nutrition" />

            <TextView
                android:id="@+id/cat_label_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Fruit"
                android:textColor="@color/m3_widget_text_primary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/cat_progress_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="70dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="40"
                android:progressDrawable="@drawable/m3_progress_bar" />

            <TextView
                android:id="@+id/cat_count_2"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:gravity="end"
                android:text="8"
                android:textColor="@color/m3_widget_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Category Row 3 -->
        <LinearLayout
            android:id="@+id/cat_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cat_icon_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="icon"
                android:src="@drawable/ic_cat_grass" />

            <TextView
                android:id="@+id/cat_label_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Arrel i bulb"
                android:textColor="@color/m3_widget_text_primary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/cat_progress_3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="70dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="20"
                android:progressDrawable="@drawable/m3_progress_bar" />

            <TextView
                android:id="@+id/cat_count_3"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:gravity="end"
                android:text="4"
                android:textColor="@color/m3_widget_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
